{
    "name": "@recursyve/nestjs-rosetta",
    "version": "1.0.0",
    "scripts": {
        "build": "gulp build --dist node_modules/@recursyve",
        "prebuild:prod": "npm run clean",
        "build:prod": "gulp build",
        "test": "jest",
        "clean": "gulp clean:bundle",
        "prerelease": "gulp copy-misc && gulp build --dist node_modules/@recursyve",
        "publish": "npm run prerelease && npm run build:prod && ./node_modules/.bin/lerna publish --force-publish --exact -m \"Publish %s release\"",
        "publish:beta": "npm run prerelease && npm run build:prod && ./node_modules/.bin/lerna publish --dist-tag=beta -m \"Publish %s release\""
    },
    "peerDependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "rxjs": "^7.5.5",
        "accept-language-parser": "^1.5.0",
        "reflect-metadata": "^0.2.2"
    },
    "devDependencies": {
        "@nestjs/common": "^11.1.0",
        "@nestjs/core": "^11.1.0",
        "@nestjs/mongoose": "^11.0.3",
        "@nestjs/platform-express": "^11.1.0",
        "@nestjs/sequelize": "^11.0.0",
        "@recursyve/nice-ts-utils": "^0.0.2",
        "@types/accept-language-parser": "^1.5.7",
        "@types/body-parser": "^1.19.5",
        "@types/connect": "^3.4.38",
        "@types/debug": "^4.1.12",
        "@types/express": "^5.0.1",
        "@types/jest": "^29.5.14",
        "@types/ms": "^2.1.0",
        "@types/node": "^22.14.1",
        "@types/validator": "^13.15.0",
        "accept-language-parser": "^1.5.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "delete-empty": "^3.0.0",
        "gulp": "^4.0.2",
        "gulp-clean": "^0.4.0",
        "gulp-sourcemaps": "^3.0.0",
        "gulp-typescript": "^6.0.0-alpha.1",
        "jest": "^29.7.0",
        "lerna": "^6.4.0",
        "mongoose": "^8.13.2",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sequelize": "^6.37.7",
        "sequelize-typescript": "^2.1.6",
        "sqlite3": "^5.1.7",
        "ts-jest": "^29.3.2",
        "ts-node": "^10.9.2",
        "tslint": "^6.1.3",
        "typescript": "^5.8.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "packages",
        "testRegex": ".spec.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "coverageDirectory": "./coverage",
        "testEnvironment": "node",
        "collectCoverage": true
    },
    "dependencies": {
        "@nestjs/mongoose": "^9.2.1"
    }
}
